{
  "functions": {
    "api/page.js": {
      "includeFiles": "dist/index.html"
    },
    "api/notify-app-update.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/page?path=$1"
    }
  ]
}
